color c0 = input.color(#ecb34b, "Saturn color")
bool enabled0 = input.bool(true, "Show Saturn")
float lon0 = f_lookup(t0, l0, time)
string displayMode = input.string("Unwrapped", "Display", options=["Unwrapped", "Wrapped degrees", "Clock phase"])
float v0 = displayMode == "Unwrapped" ? lon0 : f_mod(lon0, displayMode == "Clock phase" ? 24 : 360)
bool bridge0 = displayMode != "Unwrapped" and math.abs(v0 - v0[1]) > (displayMode == "Clock phase" ? 12 : 180)
plot(enabled0 and not bridge0 ? v0 : na, "Saturn", color=c0, style=plot.style_linebr)
var array<float> eventTimes = f_load("987175305,1707149817,2953517542,3617025403,5459840662,6051309412,8388354529,8626500989,10756714636,11699136584,13290472815,14907730627,14927871204,16092376062,18449413440,19184063269,22235961731,22480355237,25808262781,25831505457,26076666248,29101867273,29707884778,30528413196")
var array<string> eventNames = str.split("aspect Sun/Jupiter 90|clock_alignment Mars/Saturn 0|station Saturn |aspect Sun/Jupiter 120|clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 150|aspect Sun/Jupiter 180|clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 210|clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 240|station Saturn |clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 270|clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 300|clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 330|ingress Saturn 210|aspect Sun/Jupiter 0|clock_alignment Mars/Saturn 0|aspect Sun/Jupiter 30|clock_alignment Mars/Saturn 0|24_band_entry Saturn 0", "|")
if barstate.islast
    for mark in line.all
        line.delete(mark)
    for tag in label.all
        label.delete(tag)
    if showEvents
        for i = 0 to array.size(eventTimes) - 1
            int stamp = epoch + int(array.get(eventTimes, i))
            line.new(stamp, 0, stamp, 1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.gray, 80), style=line.style_dotted)
            label.new(stamp, 0, array.get(eventNames, i), xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny, color=color.new(color.gray, 85), textcolor=color.gray)
var table coverage = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(coverage, 0, 0, "Finite ephemeris: " + str.format_time(coverageStart, "yyyy-MM-dd", "UTC") + " → " + str.format_time(coverageEnd, "yyyy-MM-dd", "UTC") + (time < coverageStart or time > coverageEnd ? "\nOUTSIDE COVERAGE" : "\nUTC / apparent_of_date"), text_color=color.white, bgcolor=color.new(color.black, 20))
