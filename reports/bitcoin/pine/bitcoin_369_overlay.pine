anyContact := anyContact or (not na(p4) and low <= p4 + tolerance and high >= p4 - tolerance)
int k5 = input.int(6, "Mercury opposite branch 5")
float p5 = enabled0 and showOpposite ? f_price(lon0, k5, true) : na
plot(p5, "Mercury opposite 6", color=color.new(c0, 55), style=bookRound ? plot.style_stepline : plot.style_linebr)
anyContact := anyContact or (not na(p5) and low <= p5 + tolerance and high >= p5 - tolerance)
int k6 = input.int(7, "Mercury opposite branch 6")
