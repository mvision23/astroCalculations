plot(p7, "Mercury opposite 8", color=color.new(c0, 55), style=bookRound ? plot.style_stepline : plot.style_linebr)
anyContact := anyContact or (not na(p7) and low <= p7 + tolerance and high >= p7 - tolerance)
int k8 = input.int(9, "Mercury opposite branch 8")
