plot(p8, "Mercury opposite 9", color=color.new(c0, 55), style=bookRound ? plot.style_stepline : plot.style_linebr)
anyContact := anyContact or (not na(p8) and low <= p8 + tolerance and high >= p8 - tolerance)
alertcondition(barstate.isconfirmed and anyContact, "Confirmed price contact", "Completed bar touches an embedded planetary price channel")
bool staticOn = input.bool(true, "Static divisions A–D")
int staticCycle = input.int(11, "Static division cycle index")
static0_0 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 0) : na, "A 0", color=color.new(color.gray, 45), style=plot.style_linebr)
static0_1 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 1) : na, "A 1", color=color.new(color.gray, 45), style=plot.style_linebr)
fill(static0_0, static0_1, color=color.new(color.gray, 90), title="A band")
plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 3.5) : na, "Halfway 0", color=color.new(color.gray, 70), style=plot.style_linebr)
static1_0 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 6) : na, "B 0", color=color.new(color.gray, 45), style=plot.style_linebr)
static1_1 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 7) : na, "B 1", color=color.new(color.gray, 45), style=plot.style_linebr)
fill(static1_0, static1_1, color=color.new(color.gray, 90), title="B band")
plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 9.5) : na, "Halfway 1", color=color.new(color.gray, 70), style=plot.style_linebr)
static2_0 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 12) : na, "C 0", color=color.new(color.gray, 45), style=plot.style_linebr)
static2_1 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 13) : na, "C 1", color=color.new(color.gray, 45), style=plot.style_linebr)
fill(static2_0, static2_1, color=color.new(color.gray, 90), title="C band")
plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 15.5) : na, "Halfway 2", color=color.new(color.gray, 70), style=plot.style_linebr)
static3_0 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 18) : na, "D 0", color=color.new(color.gray, 45), style=plot.style_linebr)
static3_1 = plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 19) : na, "D 1", color=color.new(color.gray, 45), style=plot.style_linebr)
fill(static3_0, static3_1, color=color.new(color.gray, 90), title="D band")
plot(staticOn and time >= coverageStart and time <= coverageEnd ? units * (24 * staticCycle + 21.5) : na, "Halfway 3", color=color.new(color.gray, 70), style=plot.style_linebr)
if barstate.islast
    for drawing in polyline.all
        polyline.delete(drawing)
    if showFuture and time <= coverageEnd
        if enabled0 and true
            f_curve(t0, l0, k0, false, c0)
        if enabled0 and true
            f_curve(t0, l0, k1, false, c0)
        if enabled0 and true
            f_curve(t0, l0, k2, false, c0)
        if enabled0 and true
            f_curve(t0, l0, k3, false, c0)
        if enabled0 and showOpposite
            f_curve(t0, l0, k4, true, c0)
        if enabled0 and showOpposite
            f_curve(t0, l0, k5, true, c0)
        if enabled0 and showOpposite
            f_curve(t0, l0, k6, true, c0)
        if enabled0 and showOpposite
            f_curve(t0, l0, k7, true, c0)
        if enabled0 and showOpposite
            f_curve(t0, l0, k8, true, c0)
var array<float> eventTimes = f_load("274140637,341889807,604377136,649627844,1883341296,1883341296,1950136633,3732300769,4014923401,4923663904")
var array<string> eventNames = str.split("clock_alignment Mars/Saturn 0|ingress Mercury 90|24_band_entry Mercury 0|24_band_exit Mercury 0|ingress Mercury 120|24_band_entry Mercury 0|24_band_exit Mercury 0|station Mercury |clock_alignment Mars/Saturn 0|aspect Mercury/Sun 0", "|")
if barstate.islast
    for mark in line.all
        line.delete(mark)
    for tag in label.all
        label.delete(tag)
    if showEvents
        for i = 0 to array.size(eventTimes) - 1
            int stamp = epoch + int(array.get(eventTimes, i))
            line.new(stamp, 0, stamp, 1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.gray, 80), style=line.style_dotted)
            label.new(stamp, close, array.get(eventNames, i), xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny, color=color.new(color.gray, 85), textcolor=color.gray)
var table coverage = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(coverage, 0, 0, "Finite ephemeris: " + str.format_time(coverageStart, "yyyy-MM-dd", "UTC") + " → " + str.format_time(coverageEnd, "yyyy-MM-dd", "UTC") + (time < coverageStart or time > coverageEnd ? "\nOUTSIDE COVERAGE" : "\nUTC / apparent_of_date"), text_color=color.white, bgcolor=color.new(color.black, 20))
